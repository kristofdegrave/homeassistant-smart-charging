#!/usr/bin/env bash
# Local pre-commit hook: run the repo-wide structural checks as a WARNING only.
#
# Install once per clone:   git config core.hooksPath .github/hooks
#
# Two checks run here, both of them repo-wide and both able to fail on a file the commit does
# not touch: the method check (`check-method.sh`) and the watched-path check
# (`check-path-map.sh`).
#
# Warning and not blocking on purpose: a `workflow` change that renames a heading, moves a
# work-type file, re-points the routing table or adds a tree to the watched-path set is broken
# halfway through by construction, and it still has to be committable in that state. CI
# (`ci.yml`'s `method` job) runs both checks blocking on the PR, so the finding is never lost —
# only deferred to where it belongs.
#
# They check the working tree, not the staged index: a partial commit is judged against what is
# on disk, which for a warning is the useful answer (it is the tree the next commit will see).
#
# Exits 0 whatever the checks report. An environment error (no Python with PyYAML) is printed
# as one line and also exits 0: a missing local dependency must not stop a commit either.

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

for check in check-method check-path-map; do
  out=$(bash "$root/.github/$check.sh" --warn 2>&1)
  rc=$?
  if [ "$rc" -eq 2 ]; then
    printf 'pre-commit: %s skipped — %s\n' "$check" "$out" >&2
    continue
  fi
  case "$out" in
    *"warning:"*)
      printf '%s\n' "$out" >&2
      printf 'pre-commit: %s found the above; CI runs it blocking on the PR.\n' "$check" >&2
      ;;
  esac
done
exit 0
