{
  "env": {
    "SMART_CHARGING_AUTOPILOT": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(printenv SMART_CHARGING_AUTOPILOT)",
      "Edit(//**/sc-*/**)",
      "Edit(//**/scratchpad/**)"
    ],
    "deny": [
      "Edit(//**/.claude/**)",
      "Edit(//**/.github/**)",
      "Edit(//**/CLAUDE.md)",
      "Edit(//**/CLAUDE.local.md)",
      "Bash(git -c *)",
      "Bash(git * -c *)",
      "Bash(git *--config-env*)",
      "Bash(git -C * config *)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--exec=*)",
      "Bash(git fetch * -u *)",
      "Bash(git -C * fetch * -u *)",
      "Bash(git *--output*)",
      "Bash(git * push * main*)",
      "Bash(git * push * HEAD:main*)",
      "Bash(git push * main*)"
    ]
  }
}
