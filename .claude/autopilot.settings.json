{
  "env": {
    "SMART_CHARGING_AUTOPILOT": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(printenv SMART_CHARGING_AUTOPILOT)",
      "Bash(git -C *)",
      "Edit(//**/sc-*/**)",
      "Edit(//**/scratchpad/**)"
    ],
    "deny": [
      "Edit(//**/.claude/**)",
      "Edit(//**/.github/**)",
      "Edit(//**/CLAUDE.md)",
      "Edit(//**/CLAUDE.local.md)",
      "Bash(git -c *)",
      "Bash(git * -c *)",
      "Bash(git *--config-env*)",
      "Bash(git -C * config *)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--output*)",
      "Bash(git * push * main*)",
      "Bash(git * push * HEAD:main*)",
      "Bash(git push * main*)",
      "Bash(git rebase*)",
      "Bash(git * rebase*)",
      "Bash(git bisect*)",
      "Bash(git * bisect*)",
      "Bash(git submodule*)",
      "Bash(git * submodule*)",
      "Bash(git difftool*)",
      "Bash(git * difftool*)",
      "Bash(git filter-branch*)",
      "Bash(git * filter-branch*)",
      "Bash(git clone*)",
      "Bash(git * clone*)",
      "Bash(git *--exec*)",
      "Bash(git *grep*-O*)",
      "Bash(git *--open-files-in-pager*)",
      "Bash(git *--extcmd*)",
      "Edit(//**/.git)",
      "Edit(//**/.git/**)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(git init*)",
      "Bash(git * init*)",
      "Bash(git mv*)",
      "Bash(git * mv*)",
      "Bash(git restore*)",
      "Bash(git * restore*)",
      "Bash(git apply*)",
      "Bash(git * apply*)",
      "Bash(git am *)",
      "Bash(git -C * am *)",
      "Bash(git hash-object*)",
      "Bash(git * hash-object*)",
      "Bash(git update-index*)",
      "Bash(git * update-index*)",
      "Bash(git read-tree*)",
      "Bash(git * read-tree*)",
      "Bash(git commit-tree*)",
      "Bash(git * commit-tree*)",
      "Bash(git update-ref*)",
      "Bash(git * update-ref*)",
      "Bash(git mktree*)",
      "Bash(git * mktree*)",
      "Bash(git fast-import*)",
      "Bash(git * fast-import*)",
      "Bash(git * checkout * -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git *--git-dir*)",
      "Bash(git *--work-tree*)",
      "Edit(//**/HEAD)",
      "Bash(git * fetch * pull/*)",
      "Bash(git fetch * pull/*)",
      "Bash(git cherry-pick*)",
      "Bash(git * cherry-pick*)",
      "Bash(git switch*)",
      "Bash(git * switch*)"
    ]
  }
}
