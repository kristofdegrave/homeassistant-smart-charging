      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh api repos/kristofdegrave/homeassistant-smart-charging/issues*)",
      "Bash(gh api repos/kristofdegrave/homeassistant-smart-charging/pulls*)",
      "Bash(gh api -X GET *)",
      "Bash(gh api -X POST repos/kristofdegrave/homeassistant-smart-charging/issues*)",
      "Bash(gh api -X PATCH repos/kristofdegrave/homeassistant-smart-charging/issues*)",
      "Bash(gh api -X POST repos/kristofdegrave/homeassistant-smart-charging/milestones *)",
      "Bash(gh api rate_limit*)",
      "Bash(gh api graphql -f query='query{ repository*)",
      "Bash(gh api graphql -f query='{viewer{login}}'*)",
      "Bash(gh search issues *)",
      "Bash(gh search prs *)",
      "Bash(gh project view *)",
      "Bash(gh project field-list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh label list *)",
      "Bash(bash .github/profile-env.sh)",
      "Bash(bash .github/gh-as-bot.sh *)",
      "Bash(bash .github/test-gh-as-bot.sh)",
      "Bash(sh .github/check-*)",
      "Bash(bash .github/check-*)",
      "Bash(bash .github/test-check-*)",
      "Bash(sh .claude/hooks/test-block-destructive-git.sh)",
      "Bash(sh .claude/hooks/test-block-main-checkout-edits.sh)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Read(//**/sc-*/**)",
      "Read(//**/scratchpad/**)"
    ],
    "ask": [
      "Bash(gh issue edit *--remove-label*needs-approval*)",
      "Bash(gh api *DELETE*labels*)",
      "Bash(gh api *labels*DELETE*)",
      "Bash(gh api *PUT*labels*)",
      "Bash(gh api *labels*PUT*)",
      "Bash(gh api *PATCH*labels*)",
      "Bash(gh api *labels*PATCH*)",
      "Bash(gh api graphql *LabelsFromLabelable*)",
      "Bash(gh api graphql *Ref*)",
      "Bash(gh api graphql *createCommitOnBranch*)",
      "Bash(gh api graphql *updateRepository*)",
      "Bash(gh api graphql *BranchProtectionRule*)",
      "Bash(gh api *-X*-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api graphql *query=*query=*)",
      "Bash(gh api graphql *=@*)",
      "Bash(gh api graphql *--input*)",
      "Bash(gh api graphql *updateIssue*)",
      "Bash(gh api graphql *PullRequest*)",
      "Bash(gh api *issues/*--input*)",
      "Bash(gh api -X PATCH *issues/*=@*)",
      "Bash(gh api graphql *mergeBranch*)",
      "Bash(gh api graphql -F *mutation*)",
      "Bash(gh api graphql *operationName*)",
      "Bash(gh api graphql *input:*input:*)",
      "Bash(gh api repos/* -X*)",
      "Bash(gh api *..*)",
      "Bash(gh api *pulls/*/replies*)",
      "Bash(gh api *pulls/*/comments*in_reply_to*)",
      "Bash(gh api *pulls/*/comments* -f *)",
      "Bash(gh api *pulls/*/comments* -F *)",
      "Bash(gh api repos/kristofdegrave/homeassistant-smart-charging/pulls *)",
      "Bash(gh api repos/kristofdegrave/homeassistant-smart-charging/pulls?*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-git.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-main-checkout-edits.sh\""
          }
        ]
      }
    ]
  }
}
